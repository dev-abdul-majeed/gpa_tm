<!-- _form.html.erb partial -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
  <%= form_with model: [@course, @group], local: true, html: { id: 'group-form' } do |form| %>
    
    <!-- Group Name -->
    <div class="mb-8">
      <label class="block text-sm font-medium text-slate-700 mb-2">
        <i class="fas fa-layer-group mr-2 text-emerald-500"></i>
        Group Name
      </label>
      <%= form.text_field :group_name, 
        class: "w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors duration-200",
        placeholder: "Enter group name...",
        required: true %>
      <% if @group.errors[:group_name].any? %>
        <p class="mt-2 text-sm text-red-600">
          <i class="fas fa-exclamation-circle mr-1"></i>
          <%= @group.errors[:group_name].first %>
        </p>
      <% end %>
    </div>

    <!-- Students Selection -->
    <div class="mb-8">
      <label class="block text-sm font-medium text-slate-700 mb-4">
        <i class="fas fa-users mr-2 text-emerald-500"></i>
        Select Students for this Group
        <span class="text-slate-500 font-normal">(optional - you can add students later)</span>
      </label>
      
      <% if @available_students.any? %>
        <div class="mb-4">
          <div class="flex items-center space-x-4 text-sm">
            <button type="button" id="select-all" class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-md hover:bg-emerald-200 transition-colors duration-200">
              <i class="fas fa-check-double mr-1"></i>
              Select All
            </button>
            <button type="button" id="deselect-all" class="px-3 py-1 bg-slate-100 text-slate-700 rounded-md hover:bg-slate-200 transition-colors duration-200">
              <i class="fas fa-times mr-1"></i>
              Deselect All
            </button>
            <span id="selected-count" class="text-slate-500">0 selected</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-h-96 overflow-y-auto border border-slate-200 rounded-lg p-4">
          <% @available_students.each do |student| %>
            <div class="student-card relative cursor-pointer">
              <input type="checkbox" 
                     name="group[student_ids][]" 
                     value="<%= student.id %>" 
                     id="student_<%= student.id %>"
                     class="student-checkbox absolute opacity-0"
                     <%= 'checked' if @group.persisted? && @group.students.include?(student) %>>
              <label for="student_<%= student.id %>" 
                     class="block p-4 border-2 border-slate-200 rounded-lg hover:border-emerald-300 transition-all duration-200 cursor-pointer">
                <div class="flex items-center space-x-3">
                  <div class="flex-shrink-0">
                    <div class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center">
                      <i class="fas fa-user text-slate-500"></i>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-slate-800 truncate">
                      <%= student.full_name %>
                    </p>
                    <p class="text-xs text-slate-500">
                      ID: <%= student.id %>
                    </p>
                  </div>
                  <div class="flex-shrink-0">
                    <div class="checkmark hidden w-5 h-5 bg-emerald-500 rounded-full flex items-center justify-center">
                      <i class="fas fa-check text-white text-xs"></i>
                    </div>
                  </div>
                </div>
              </label>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 text-slate-500">
          <i class="fas fa-info-circle text-2xl mb-2"></i>
          <p>No students available for grouping.</p>
        </div>
      <% end %>
    </div>

    <!-- Submit Buttons -->
    <div class="flex items-center justify-end space-x-4 pt-6 border-t border-slate-200">
      <%= link_to course_groups_path(@course), 
        class: "px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors duration-200" do %>
        Cancel
      <% end %>
      
      <%= form.submit (@group.persisted? ? "Update Group" : "Create Group"), 
        class: "px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-medium rounded-lg transition-colors duration-200 shadow-sm hover:shadow-md" %>
    </div>
  <% end %>
</div>

<style>
  .student-checkbox:checked + label {
    border-color: #10b981;
    background-color: #f0fdf4;
  }
  
  .student-checkbox:checked + label .checkmark {
    display: flex !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function initializeGroupForm() {
    const checkboxes = document.querySelectorAll('.student-checkbox');
    const selectAllBtn = document.getElementById('select-all');
    const deselectAllBtn = document.getElementById('deselect-all');
    const selectedCount = document.getElementById('selected-count');
    
    function updateSelectedCount() {
      const checkedCount = document.querySelectorAll('.student-checkbox:checked').length;
      if (selectedCount) {
        selectedCount.textContent = `${checkedCount} selected`;
      }
    }
    
    // Remove existing event listeners to prevent duplicates
    checkboxes.forEach(checkbox => {
      checkbox.removeEventListener('change', updateSelectedCount);
    });
    
    // Add event listeners to all checkboxes
    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', updateSelectedCount);
    });
    
    // Select all functionality
    if (selectAllBtn) {
      selectAllBtn.removeEventListener('click', selectAllHandler);
      selectAllBtn.addEventListener('click', selectAllHandler);
    }
    
    // Deselect all functionality
    if (deselectAllBtn) {
      deselectAllBtn.removeEventListener('click', deselectAllHandler);
      deselectAllBtn.addEventListener('click', deselectAllHandler);
    }
    
    function selectAllHandler() {
      const currentCheckboxes = document.querySelectorAll('.student-checkbox');
      currentCheckboxes.forEach(checkbox => {
        checkbox.checked = true;
      });
      updateSelectedCount();
    }
    
    function deselectAllHandler() {
      const currentCheckboxes = document.querySelectorAll('.student-checkbox');
      currentCheckboxes.forEach(checkbox => {
        checkbox.checked = false;
      });
      updateSelectedCount();
    }
    
    // Initialize count
    updateSelectedCount();
  }
  
  // Initialize on page load
  initializeGroupForm();
  
  // Re-initialize on Turbo navigation (for Rails 7+)
  document.addEventListener('turbo:load', initializeGroupForm);
  
  // Re-initialize on Turbolinks navigation (for Rails 6)
  document.addEventListener('turbolinks:load', initializeGroupForm);
});
</script>