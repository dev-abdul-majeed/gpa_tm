<h1>Your Courses</h1>

<table>
  <thead>
    <tr>
      <th>Course Name</th>
      <th>Description</th>
      <th>Number of Students</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @courses.each do |course| %>
      <tr>
        <td><%= course.name %></td>
        <td><%= course.description %></td>
        <td><%= course.students.count %></td>  <!-- Number of enrolled students -->
        <td>
          <%= link_to 'Edit', edit_course_path(course) %> |
          <%= link_to "Delete", course_path(course), data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'}, class: "text-red-600 hover:underline" %>

        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Create New Course', new_course_path, class: 'btn btn-primary' %>
