<div class="min-h-screen bg-gradient-to-br from-slate-50 to-emerald-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center mb-2">
        <%= link_to course_groups_path(@course), class: "text-slate-500 hover:text-emerald-600 transition-colors duration-200 mr-2" do %>
          <i class="fas fa-arrow-left"></i>
        <% end %>
        <h1 class="text-3xl font-bold text-slate-800">Edit Group</h1>
      </div>
      <p class="text-slate-600">in <strong><%= @course.name %></strong></p>
    </div>

    <!-- Form -->
    <%= render 'form' %>
  </div>
</div>