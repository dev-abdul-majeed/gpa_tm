<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
  <div class="container mx-auto px-4 py-8">
    <!-- Assignment Header -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 mb-8">
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <div class="flex items-center space-x-4 mb-4">
            <div class="w-12 h-12 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-xl flex items-center justify-center">
              <i class="fas fa-clipboard-list text-white text-xl"></i>
            </div>
            <div>
              <h1 class="text-3xl font-bold text-slate-800 mb-1"><%= @assignment.title %></h1>
              <p class="text-slate-600">Peer evaluation assignment overview</p>
            </div>
          </div>

          <div class="flex items-center space-x-6 text-sm text-slate-600">
            <div class="flex items-center space-x-2 bg-slate-100 rounded-lg px-3 py-2">
              <i class="fas fa-graduation-cap text-emerald-600"></i>
              <span class="font-medium">Course: <%= @course.name %></span>
            </div>
          </div>
        </div>

        <div class="flex space-x-3">

          <%= link_to generate_sample_peer_marks_course_assignment_path(@course, @assignment),
                      method: :post,
                      data: {
                        turbo_method: :post,
                        turbo_confirm: 'Are you sure you want to generate sample peer marks for all unsubmitted students? This action cannot be undone.'
                      },
                      class: "inline-flex items-center px-4 py-2 bg-red-500 hover:bg-orange-600 text-white font-medium rounded-lg transition duration-200" do %>
            <i class="fas fa-magic mr-2"></i>
            Generate Sample Peer Marks
          <% end %>

          <%= link_to assignments_path(@course), class: 'inline-flex items-center px-4 py-2 bg-slate-500 hover:bg-slate-600 text-white font-medium rounded-lg transition duration-200' do %>
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Assignments
          <% end %>
        </div>
      </div>
    </div>

    <!-- Groups Section -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center">
            <i class="fas fa-users text-white"></i>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-slate-800">Groups</h2>
            <p class="text-slate-600"><%= @groups.count %> group<%= 's' if @groups.count != 1 %> assigned to this assignment</p>
          </div>
        </div>
      </div>

      <% if @groups.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @groups.each do |group| %>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:border-emerald-200 transition-all duration-200">
              <div class="p-6">
                <!-- Group Header -->
                <div class="flex items-center justify-between mb-6">
                  <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-r from-emerald-100 to-teal-100 rounded-lg flex items-center justify-center">
                      <i class="fas fa-layer-group text-emerald-600"></i>
                    </div>
                    <div>
                      <h3 class="text-lg font-semibold text-slate-800"><%= group.group_name %></h3>
                      <p class="text-sm text-slate-600"><%= @group_stats[group.id][:student_count] %> students</p>
                    </div>
                  </div>
                  <% switch_text = @assignment.webavalia? ? 'Compare with Qass' : 'Compare with Webavalia' %>
                  <div class="mt-4">
                    <div class="p-[2px] bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg hover:from-purple-600 hover:to-pink-600 transition-all duration-200">
                      <%= link_to assignment_view_marks_path(@assignment, group, params: { course_id: @course.id, conversion: @assignment.webavalia? ? 'webavalia-to-qass' : 'qass-to-webavalia' }),
                        class: 'group relative w-full bg-white font-medium py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center space-x-2' do %>
                        <i class="fas fa-code-compare text-sm bg-gradient-to-r from-purple-500 to-pink-500 bg-clip-text text-transparent"></i>
                        <span class="bg-gradient-to-r from-purple-500 to-pink-500 bg-clip-text text-transparent"><%= switch_text %></span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Students List -->
                <div class="mb-6">
                  <h4 class="text-sm font-medium text-slate-700 mb-3 flex items-center">
                    <i class="fas fa-user-friends text-emerald-600 mr-2 text-xs"></i>
                    Students
                  </h4>
                  <div class="space-y-2">
                    <% if group.students.any? %>
                      <% group.students.limit(3).each do |student| %>
                        <div class="flex items-center space-x-3">
                          <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center">
                            <span class="text-xs font-medium text-white">
                              <%= student.first_name&.first&.upcase || student.name&.first&.upcase || 'S' %>
                            </span>
                          </div>
                          <span class="text-sm text-slate-700">
                            <%= student.first_name ? "#{student.first_name} #{student.last_name}" : student.name %>
                          </span>
                        </div>
                      <% end %>
                      <% if group.students.count > 3 %>
                        <div class="flex items-center space-x-3 ml-2">
                          <div class="w-6 h-6 bg-slate-200 rounded-full flex items-center justify-center">
                            <span class="text-xs text-slate-600">+<%= group.students.count - 3 %></span>
                          </div>
                          <span class="text-sm text-slate-500">
                            <%= group.students.count - 3 %> more student<%= 's' if group.students.count - 3 != 1 %>
                          </span>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="flex items-center space-x-2 text-slate-500">
                        <i class="fas fa-exclamation-circle text-orange-500"></i>
                        <span class="text-sm italic">No students assigned</span>
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Statistics -->
                <div class="mb-6">
                  <div class="bg-gradient-to-r from-emerald-50 to-teal-50 rounded-lg p-4 border border-emerald-100">
                    <div class="flex items-center justify-center space-x-2">
                      <i class="fas fa-check-circle text-emerald-600"></i>
                      <div class="text-center">
                        <div class="text-2xl font-bold text-emerald-700">
                          <%= @group_stats[group.id][:submissions_count] %>
                        </div>
                        <div class="text-sm text-emerald-600 font-medium">Peer Evaluations</div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- View Marks Button -->
                <%= link_to assignment_view_marks_path(@assignment, group, params: { course_id: @course.id }),
                            class: 'w-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-medium py-3 px-4 rounded-lg transition duration-200 flex items-center justify-center space-x-2' do %>
                  <i class="fas fa-chart-line"></i>
                  <span>View Evaluation Matrix</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-xl border border-slate-200 p-12 text-center">
          <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-users text-slate-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-slate-800 mb-2">No Groups Assigned</h3>
          <p class="text-slate-600 mb-6 max-w-md mx-auto">
            This assignment doesn't have any groups yet. Create and assign groups to enable peer evaluation.
          </p>

          <%= link_to course_groups_path(@course),
                class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-medium rounded-lg transition duration-200" do %>
              <i class="fas fa-plus mr-2"></i>
              <span>Manage Groups</span>
            <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
