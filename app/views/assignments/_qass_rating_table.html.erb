<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="bg-gradient-to-r from-emerald-50 to-teal-50 border-b border-slate-200">
          <th class="px-4 sm:px-6 py-4 text-left min-w-[10rem]">
            <div class="flex items-center space-x-2">
              <i class="fas fa-users text-emerald-600" aria-hidden="true"></i>
              <span class="font-semibold text-slate-700 text-sm">Receiver ↓ / Giver →</span>
            </div>
          </th>
          <% @students.each do |giver| %>
            <th class="px-2 sm:px-4 py-4 text-center border-l border-slate-200 min-w-[5.5rem]">
              <div class="flex flex-col items-center gap-1.5">
                <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center shrink-0" aria-hidden="true">
                  <i class="fas fa-user text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-xs leading-tight max-w-[5.5rem] truncate" title="<%= giver.full_name %>">
                  <%= giver.full_name %>
                </span>
              </div>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @students.each_with_index do |receiver, index| %>
          <tr class="<%= index.even? ? 'bg-slate-50/50' : 'bg-white' %> hover:bg-emerald-50/30 transition-colors duration-200">
            <td class="px-4 sm:px-6 py-4 border-r border-slate-200">
              <div class="flex items-center space-x-3 min-w-0">
                <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center shrink-0" aria-hidden="true">
                  <i class="fas fa-user text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 truncate" title="<%= receiver.full_name %>"><%= receiver.full_name %></span>
              </div>
            </td>
            <% @students.each do |giver| %>
              <td class="px-2 sm:px-4 py-3 text-center border-l border-slate-200 align-middle">
                <% mark = marks_by_pair[[giver.id, receiver.id]] %>
                <% if mark.present? %>
                  <%= render "assignments/mark_badge", value: mark, variant: :score, precision: 4 %>
                <% else %>
                  <%= render "assignments/mark_badge", variant: :missing %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
