<%= form_with model: course, local: true, html: { class: "space-y-6" } do |form| %>
  <!-- Error Messages -->
  <% if course.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <i class="fas fa-exclamation-triangle text-red-400 mt-0.5"></i>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-semibold text-red-800 mb-2">
            Please fix the following <%= pluralize(course.errors.count, "error") %>:
          </h3>
          <ul class="text-sm text-red-700 space-y-1">
            <% course.errors.full_messages.each do |message| %>
              <li class="flex items-center">
                <i class="fas fa-circle text-red-400 text-xs mr-2"></i>
                <%= message %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Course Name Field -->
  <div class="form-group">
    <%= form.label :name, class: "block text-sm font-semibold text-slate-700 mb-2" do %>
      <i class="fas fa-book mr-2 text-emerald-500"></i>
      Course Name
    <% end %>
    <div class="relative">
      <%= form.text_field :name, 
          placeholder: "e.g., Introduction to Biology",
          class: "w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors duration-200 text-slate-800 placeholder-slate-400 #{course.errors[:name].any? ? 'border-red-300 focus:ring-red-500 focus:border-red-500' : ''}" %>
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
        <i class="fas fa-edit text-slate-400"></i>
      </div>
    </div>
    <% if course.errors[:name].any? %>
      <p class="mt-2 text-sm text-red-600 flex items-center">
        <i class="fas fa-exclamation-circle mr-1"></i>
        <%= course.errors[:name].first %>
      </p>
    <% end %>
  </div>

  <!-- Course Description Field -->
  <div class="form-group">
    <%= form.label :description, class: "block text-sm font-semibold text-slate-700 mb-2" do %>
      <i class="fas fa-align-left mr-2 text-emerald-500"></i>
      Course Description
    <% end %>
    <div class="relative">
      <%= form.text_area :description, 
          rows: 5,
          placeholder: "Describe what students will learn in this course, the topics covered, and any prerequisites...",
          class: "w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors duration-200 text-slate-800 placeholder-slate-400 resize-vertical #{course.errors[:description].any? ? 'border-red-300 focus:ring-red-500 focus:border-red-500' : ''}" %>
      <div class="absolute top-3 right-3 pointer-events-none">
        <i class="fas fa-paragraph text-slate-400"></i>
      </div>
    </div>
    <% if course.errors[:description].any? %>
      <p class="mt-2 text-sm text-red-600 flex items-center">
        <i class="fas fa-exclamation-circle mr-1"></i>
        <%= course.errors[:description].first %>
      </p>
    <% else %>
      <p class="mt-2 text-sm text-slate-500 flex items-center">
        <i class="fas fa-lightbulb mr-1"></i>
        A good description helps students understand what they'll learn
      </p>
    <% end %>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-between pt-6 border-t border-slate-200">
    
    
    <div class="flex items-center space-x-3">
      <%= link_to teacher_home_path, 
          class: "inline-flex items-center px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 hover:border-slate-400 transition-colors duration-200" do %>
        <i class="fas fa-times mr-2"></i>
        Cancel
      <% end %>
      
      <%= form.submit "Create Course", 
          class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5",
          data: { 
            disable_with: "<i class='fas fa-spinner fa-spin mr-2'></i>Creating Course..."
          } %>
    </div>
  </div>
<% end %>



