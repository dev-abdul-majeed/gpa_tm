<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
  <div class="min-h-screen p-6">
    <div class="max-w-6xl mx-auto">
      <div class="mb-6">
        <%= link_to teacher_home_path, class: "inline-flex items-center text-slate-600 hover:text-emerald-600 transition-colors duration-200" do %>
          <i class="fas fa-arrow-left mr-2"></i>
          <span>Back to Dashboard</span>
        <% end %>
      </div>
      <div class="mb-8 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-xl flex items-center justify-center shadow-md">
            <i class="fas fa-clipboard-list text-white"></i>
          </div>
          <div>
            <h1 class="text-3xl font-bold text-slate-800">Assignments</h1>
            <p class="text-slate-600 text-sm">Review and manage all your assignments grouped by course</p>
          </div>
        </div>
        <%= link_to new_assignment_wizard_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-lg hover:from-emerald-600 hover:to-teal-600 transition-colors" do %>
          <i class="fas fa-plus"></i>
          <span>Create Assignment</span>
        <% end %>
      </div>

      <% if @assignments.present? %>
        <% assignments_by_course = @assignments.group_by(&:course) %>

        <% assignments_by_course.sort_by { |course, _| course.name.downcase }.each do |course, assignments| %>
          <% next if assignments.blank? %>
          <div class="mb-10">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white border border-emerald-200 rounded-lg flex items-center justify-center">
                  <i class="fas fa-book text-emerald-600"></i>
                </div>
                <div>
                  <h2 class="text-2xl font-semibold text-slate-800"><%= course.name %></h2>
                </div>
              </div>
              <div class="text-sm bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-medium">
                <%= assignments.count %> <%= 'Assignment'.pluralize(assignments.count) %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <% assignments.each do |assignment| %>
                <div class="bg-white rounded-xl p-6 border border-slate-200 hover:shadow-md transition-shadow">
                  <div class="flex items-start justify-between mb-3">
                    <div>
                      <h3 class="text-xl font-semibold text-slate-800"><%= assignment.title %></h3>
                      <div class="mt-1 flex items-center gap-2 text-xs">
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                          <i class="<%= assignment.assignment_type == 'qass' ? 'fas fa-question-circle' : 'fas fa-globe' %>"></i>
                          <%= assignment.assignment_type.titleize %>
                        </span>
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-slate-50 text-slate-700 border border-slate-200">
                          <i class="fas fa-bullseye"></i>
                          Rating Scale <%= assignment.rating_scale %>
                        </span>
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-slate-50 text-slate-700 border border-slate-200">
                          <i class="fas fa-star"></i>
                          Model <%= assignment.rating_model %>
                        </span>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-xs text-slate-500">Created <%= time_ago_in_words(assignment.created_at) %> ago</p>
                    </div>
                  </div>

                  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="flex items-center gap-2 text-slate-700 text-sm">
                      <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
                        <i class="fas fa-play text-green-600 text-xs"></i>
                      </div>
                      <div>
                        <p class="text-xs text-slate-500">Starts</p>
                        <p><%= l(assignment.start_date_time, format: :long) rescue assignment.start_date_time %></p>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 text-slate-700 text-sm">
                      <div class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center">
                        <i class="fas fa-stop text-red-600 text-xs"></i>
                      </div>
                      <div>
                        <p class="text-xs text-slate-500">Ends</p>
                        <p><%= l(assignment.end_date_time, format: :long) rescue assignment.end_date_time %></p>
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 flex items-center gap-3">
                    <div class="flex items-center gap-2 text-sm">
                      <div class="w-6 h-6 <%= assignment.calibration ? 'bg-emerald-100' : 'bg-slate-100' %> rounded-full flex items-center justify-center">
                        <i class="fas fa-<%= assignment.calibration ? 'check' : 'times' %> text-<%= assignment.calibration ? 'emerald' : 'slate' %>-600 text-[10px]"></i>
                      </div>
                      <span class="text-slate-700">Calibration: <%= assignment.calibration ? 'Enabled' : 'Disabled' %></span>
                    </div>

                    <% if assignment.assignment_type == 'webavalia' %>
                      <div class="text-sm text-slate-700">
                        Self-rating weight: <%= number_with_precision(assignment.self_rating_weight, precision: 2) %>%
                      </div>
                    <% end %>
                  </div>

                  <div class="mt-6 flex flex-wrap gap-2">
                    <%= link_to edit_course_assignment_path(assignment.course, assignment), class: "inline-flex items-center gap-2 px-3 py-2 text-sm rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50" do %>
                      <i class="fas fa-edit"></i>
                      <span>Edit</span>
                    <% end %>

                    <%= link_to course_assignment_path(assignment.course, assignment), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this assignment?' }, class: "inline-flex items-center gap-2 px-3 py-2 text-sm rounded-lg border border-red-300 text-red-700 hover:bg-red-50" do %>
                      <i class="fas fa-trash"></i>
                      <span>Delete</span>
                    <% end %>

                    <%= link_to course_assignment_path(assignment.course, assignment), class: "inline-flex items-center gap-2 px-3 py-2 text-sm rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 text-white hover:from-emerald-600 hover:to-teal-600" do %>
                      <i class="fas fa-folder-open"></i>
                      <span>Open</span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-16 bg-white rounded-xl border border-dashed border-slate-300">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-clipboard text-slate-400 text-xl"></i>
          </div>
          <p class="text-slate-600">No assignments found.</p>
          <div class="mt-4">
            <%= link_to "Create Assignment", new_assignment_wizard_path, class: "inline-block px-4 py-2 rounded-md bg-gradient-to-r from-emerald-500 to-teal-500 text-white hover:from-emerald-600 hover:to-teal-600" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>


