<div class="min-h-screen bg-white pt-10">
  <div class="max-w-2xl mx-auto">
    <!-- Page Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full mb-4 shadow-lg">
        <i class="fas fa-school text-white text-2xl"></i>
      </div>
      <h1 class="text-3xl font-bold text-slate-800 mb-2">Create a New School</h1>
      <p class="text-slate-600">Add a new educational institution to the system</p>
    </div>

    <!-- Form Container -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
      <div class="bg-gradient-to-r from-emerald-500 to-teal-500 px-6 py-4">
        <div class="flex items-center text-white">
          <i class="fas fa-plus-circle mr-3 text-lg"></i>
          <h2 class="text-xl font-semibold">School Details</h2>
        </div>
      </div>
      
      <div class="p-6">
        <%= render 'form', school: @school %>
      </div>
    </div>
  </div>
</div>
