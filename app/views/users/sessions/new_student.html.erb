<section class="min-h-screen flex items-center justify-center p-6" style="background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);">
  <div class="w-full max-w-md">
    <!-- Floating Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-70 left-10 w-32 h-32 rounded-full opacity-10 floating-animation" style="background: linear-gradient(135deg, #f97316 0%, #f59e0b 100%);"></div>
      <div class="absolute bottom-20 right-10 w-24 h-24 rounded-full opacity-15 floating-animation" style="background: linear-gradient(135deg, #f97316 0%, #f59e0b 100%); animation-delay: -2s;"></div>
      <div class="absolute top-1/2 left-1/4 w-16 h-16 rounded-full opacity-20 floating-animation" style="background: linear-gradient(135deg, #f97316 0%, #f59e0b 100%); animation-delay: -4s;"></div>
    </div>

    <!-- Login Card -->
    <div class="rounded-2xl shadow-2xl p-8 border border-slate-200 relative z-10" style="backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.95);">
      <!-- Logo Section -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-xl mb-4 shadow-lg" style="background: linear-gradient(135deg, #f97316 0%, #f59e0b 100%);">
          <i class="fas fa-book-reader text-white text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-800 mb-2">Student Portal</h1>
        <p class="text-slate-600">Your learning journey begins</p>
      </div>

      <%= render partial: 'users/sessions/login_form', locals: { login_url: students_sign_in_path, color_scheme: 'student' } %>

      <!-- Footer -->
      <div class="mt-6 text-center">
        <p class="text-sm text-slate-500">
          First time here? <a href="#" class="text-orange-600 hover:text-orange-500 font-medium">Create Account</a>
        </p>
      </div>
    </div>
  </div>
</section>