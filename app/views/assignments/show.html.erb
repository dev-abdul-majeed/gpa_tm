<!-- app/views/assignments/show.html.erb -->
<div class="container mx-auto px-4 py-8">
  <!-- Assignment Header -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @assignment.title %></h1>
        <div class="flex items-center space-x-6 text-sm text-gray-500">
          <span class="flex items-center">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
            </svg>
            Course: <%= @course.name %>
          </span>
          
        </div>
      </div>
      <div class="flex space-x-3">
        <%= link_to 'Back', assignments_path(@course), class: 'bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded transition duration-200' %>
      </div>
    </div>
  </div>

  <!-- Groups Section -->
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Groups (<%= @groups.count %>)</h2>
    
    <% if @groups.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @groups.each do |group| %>
          <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 border border-gray-200">
            <div class="p-6">
              <!-- Group Header -->
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-semibold text-gray-900"><%= group.group_name %></h3>
                <div class="flex items-center text-sm text-gray-500">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <%= @group_stats[group.id][:student_count] %> students
                </div>
              </div>

              <!-- Students List -->
              <div class="mb-4">
                <h4 class="text-sm font-medium text-gray-700 mb-2">Students:</h4>
                <div class="space-y-1">
                  <% if group.students.any? %>
                    <% group.students.limit(3).each do |student| %>
                      <div class="flex items-center text-sm text-gray-600">
                        <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center mr-2">
                          <span class="text-xs font-medium text-blue-600">
                            <%= student.first_name&.first&.upcase || student.name&.first&.upcase || 'S' %>
                          </span>
                        </div>
                        <%= student.first_name ? "#{student.first_name} #{student.last_name}" : student.name %>
                      </div>
                    <% end %>
                    <% if group.students.count > 3 %>
                      <div class="text-xs text-gray-500 ml-8">
                        +<%= group.students.count - 3 %> more student<%= 's' if group.students.count - 3 != 1 %>
                      </div>
                    <% end %>
                  <% else %>
                    <p class="text-sm text-gray-500 italic">No students assigned</p>
                  <% end %>
                </div>
              </div>

              <!-- Statistics -->
              <div class="grid grid-cols-2 gap-4 mb-4 text-center">
                <div class="bg-green-50 rounded-lg p-3">
                  <div class="text-lg font-semibold text-green-600">
                    <%= @group_stats[group.id][:submissions_count] %>
                  </div>
                  <div class="text-xs text-green-700">Peer Marking Submissions</div>
                </div>
                
              </div>

              <!-- View Marks Button -->
              <%= link_to assignment_view_marks_path(@assignment, group),
                          class: 'w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-lg transition duration-200 flex items-center justify-center' do %>
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path>
                </svg>
                View Marks
              <% end %>

            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-50 rounded-lg p-8 text-center">
        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No Groups Yet</h3>
        <p class="text-gray-500">Create groups for this course to start peer marking.</p>
      </div>
    <% end %>
  </div>
</div>