<div class="min-h-screen bg-white pt-10">
  <div class="max-w-6xl mx-auto">
    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center">
        <div class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full mr-4 shadow-lg">
          <i class="fas fa-chalkboard-teacher text-white text-lg"></i>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-slate-800">My Courses</h1>
          <p class="text-slate-600">Manage and monitor your teaching portfolio</p>
        </div>
      </div>
      
      <%= link_to new_course_path, 
          class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5" do %>
        <i class="fas fa-plus mr-2"></i>
        Create New Course
      <% end %>
    </div>

    <!-- Courses Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div class="flex items-center">
          <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mr-4">
            <i class="fas fa-book text-emerald-600"></i>
          </div>
          <div>
            <p class="text-sm text-slate-600">Total Courses</p>
            <p class="text-2xl font-bold text-slate-800"><%= @courses.count %></p>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div class="flex items-center">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mr-4">
            <i class="fas fa-users text-teal-600"></i>
          </div>
          <div>
            <p class="text-sm text-slate-600">Total Students</p>
            <p class="text-2xl font-bold text-slate-800"><%= @courses.sum { |course| course.students.count } %></p>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div class="flex items-center">
          <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mr-4">
            <i class="fas fa-chart-line text-emerald-600"></i>
          </div>
          <div>
            <p class="text-sm text-slate-600">Avg. Students/Course</p>
            <p class="text-2xl font-bold text-slate-800">
              <%= @courses.count > 0 ? (@courses.sum { |course| course.students.count } / @courses.count.to_f).round(1) : 0 %>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Courses List -->
    <% if @courses.any? %>
      <div class="space-y-4">
        <% @courses.each_with_index do |course, index| %>
          <%= render 'course_card', course: course, index: index %>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-slate-100 rounded-full mb-6">
          <i class="fas fa-graduation-cap text-slate-400 text-3xl"></i>
        </div>
        <h3 class="text-xl font-semibold text-slate-700 mb-2">No courses yet</h3>
        <p class="text-slate-500 mb-6">Start building your first course to engage with students</p>
        <%= link_to new_course_path, 
            class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-lg shadow-lg transition-all duration-200" do %>
          <i class="fas fa-plus mr-2"></i>
          Create Your First Course
        <% end %>
      </div>
    <% end %>
  </div>
</div>