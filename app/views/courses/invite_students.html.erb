<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 py-8 px-4">
  <div class="max-w-6xl mx-auto">
    <!-- Back Button -->
    <div class="mb-6">
      <%= link_to courses_path, 
          class: "inline-flex items-center text-slate-600 hover:text-emerald-600 transition-colors duration-200" do %>
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Courses
      <% end %>
    </div>

    <!-- Course Info Header -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden mb-8">
      <div class="bg-gradient-to-r from-emerald-500 to-teal-500 px-8 py-6">
        <div class="flex items-center text-white">
          <div class="w-12 h-12 bg-white bg-opacity-20 rounded-full flex items-center justify-center mr-4">
            <i class="fas fa-user-plus text-2xl"></i>
          </div>
          <div>
            <h1 class="text-2xl font-bold mb-1">Invite Students</h1>
            <p class="text-emerald-100">Select students to add to your course</p>
          </div>
        </div>
      </div>
      
      <div class="p-8">
        <div class="flex items-start">
          <div class="w-10 h-10 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center mr-4 mt-1">
            <i class="fas fa-book-open text-white"></i>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-800 mb-2"><%= @course.name %></h2>
            <p class="text-slate-600 leading-relaxed"><%= @course.description %></p>
            
            <div class="flex items-center mt-4 text-sm text-slate-500">
              <i class="fas fa-users mr-2 text-emerald-500"></i>
              <span>Currently has <%= pluralize(@course.students.count, 'student') %> enrolled</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Students Selection -->
    <%= form_with model: @course, url: add_students_course_path(@course), method: :patch, local: true do |form| %>
      <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="bg-slate-50 px-8 py-4 border-b border-slate-200">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <i class="fas fa-users mr-3 text-emerald-500"></i>
              <h3 class="text-lg font-semibold text-slate-800">Available Students</h3>
              <span class="ml-3 px-3 py-1 bg-slate-200 text-slate-600 rounded-full text-sm">
                <%= @available_students.count %> available
              </span>
            </div>
            
            <div class="flex items-center space-x-4">
              <button type="button" onclick="selectAll()" class="text-sm text-emerald-600 hover:text-emerald-700 font-medium">
                Select All
              </button>
              <button type="button" onclick="clearAll()" class="text-sm text-slate-500 hover:text-slate-600 font-medium">
                Clear All
              </button>
            </div>
          </div>
        </div>

        <div class="p-8">
          <% if @available_students.any? %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
              <% @available_students.each do |student| %>
                <div class="student-card bg-slate-50 border border-slate-200 rounded-lg p-4 hover:bg-slate-100 hover:border-emerald-300 transition-all duration-200 cursor-pointer"
                     id="student-card-<%= student.id %>"
                     onclick="toggleStudent(<%= student.id %>)">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 mr-4" onclick="event.stopPropagation();">
                      <%= form.check_box :student_ids, 
                          { multiple: true, 
                            class: "w-5 h-5 text-emerald-600 bg-white border-slate-300 rounded focus:ring-emerald-500 focus:ring-2",
                            id: "student_#{student.id}",
                            onchange: "updateCardStyle(#{student.id}); updateSelectedCount();",
                            onclick: "event.stopPropagation();" }, 
                          student.id, 
                          "" %>
                    </div>
                    
                    <div class="flex-1">
                      <div class="flex items-center mb-2">
                        <div class="w-8 h-8 bg-gradient-to-r from-orange-500 to-amber-500 rounded-full flex items-center justify-center mr-3">
                          <span class="text-sm font-bold text-white"><%= student.full_name.first.upcase rescue '?' %></span>
                        </div>
                        <div>
                          <p class="font-semibold text-slate-800 text-sm"><%= student.full_name %></p>
                        </div>
                      </div>
                      
                      <div class="space-y-1 text-xs text-slate-500">
                        <div class="flex items-center">
                          <i class="fas fa-envelope mr-2 w-3"></i>
                          <span><%= student.email %></span>
                        </div>
                        <div class="flex items-center">
                          <i class="fas fa-id-badge mr-2 w-3"></i>
                          <span>ID: <%= student.id %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Selected Count and Submit -->
            <div class="flex items-center justify-between pt-6 border-t border-slate-200">
              <div class="flex items-center text-sm text-slate-600">
                <i class="fas fa-info-circle mr-2 text-emerald-500"></i>
                <span id="selected-count">0 students selected</span>
              </div>
              
              <div class="flex items-center space-x-3">
                <%= link_to courses_path, 
                    class: "inline-flex items-center px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 hover:border-slate-400 transition-colors duration-200" do %>
                  <i class="fas fa-times mr-2"></i>
                  Cancel
                <% end %>
                
                <%= form.submit "Add Selected Students", 
                    class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5",
                    id: "submit-btn",
                    disabled: true %>
              </div>
            </div>
          <% else %>
            <div class="text-center py-16">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-user-check text-slate-400 text-2xl"></i>
              </div>
              <h3 class="text-lg font-semibold text-slate-700 mb-2">All students are enrolled</h3>
              <p class="text-slate-500 mb-6">Every student in the system is already part of this course.</p>
              <%= link_to courses_path, 
                  class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-lg transition-all duration-200" do %>
                <i class="fas fa-arrow-left mr-2"></i>
                Back to Courses
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= javascript_include_tag 'invite_students' %>
