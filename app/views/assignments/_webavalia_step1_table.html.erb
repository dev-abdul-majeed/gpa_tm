<% if params['conversion'] == 'qass-to-webavalia' %>
    <% converted = true %>
<% end %>
<% webavalia_service = WebavaliaService.new(@assignment.id, @group.id, converted) %>
<% normalized_marks = webavalia_service.normalize_peer_marks() %>
<% weighted_marks = webavalia_service.weighted_marks_with_ids %>
<% row_sums = webavalia_service.row_sums %>
<% max_sum = webavalia_service.max_row_sum %>
<% divide_max_values = webavalia_service.divide_max_values %>
<% student_calculations = webavalia_service.student_calculations(@current_group_score || 18) %>

<% if params['conversion'] == 'qass-to-webavalia' %>
    <div class="mb-0 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
      <h3 class="mx-4 text-center text-emerald-700 font-semibold text-lg">Marks converted from QASS to WebAVALIA</h3>
    </div>
    <%= render partial: 'table', locals: { marks_by_pair: normalized_marks } %>
<% end %>
<div class="mb-0 mt-5 bg-white rounded-xl shadow-sm border border-slate-200 p-6 mt-2">
    <%= form_with url: save_group_marks_path(@assignment, @group), method: :post, local: true, id: "group_marks_form" do |f| %>
        <%= hidden_field_tag :course_id, @course.id %>
        <div class="flex items-center space-x-4 flex-wrap gap-4">
            <div class="flex items-center space-x-2">
                <label for="group_score" class="text-lg font-semibold text-slate-700">Group Project Score:</label>
                <%= f.number_field :group_score, id: "group_score", value: @current_group_score || 18, min: 0, max: 20, step: 1, class: "px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-medium", onchange: "updateGrades()" %>
            </div>
            <% unless params['conversion'] == 'qass-to-webavalia' %>
                <%= f.submit "Save Group Marks", class: "px-6 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-semibold rounded-lg hover:from-emerald-600 hover:to-teal-600 transition-all duration-200 shadow-md hover:shadow-lg" %>
            <% end %>
            <span class="text-sm text-slate-500">(This will update the Grade and Final Grade columns)</span>
            <% unless params['conversion'] == 'qass-to-webavalia' %>
                <span class="text-sm text-slate-500">The self rating weightage for this assignement is: <%= @assignment.self_rating_weight %></span>
            <% end %>
            </div>
            </div>
    <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full">
        <thead>
        <tr class="bg-gradient-to-r from-emerald-50 to-teal-50 border-b border-slate-200">
            <th class="px-6 py-4 text-left">
            <div class="flex items-center space-x-2">
                <i class="fas fa-users text-emerald-600"></i>
                <span class="font-semibold text-slate-700">Receiver ↓ / Giver →</span>
            </div>
            </th>
            <% @students.each do |giver| %>
            <th class="px-4 py-4 text-center border-l border-slate-200">
                <div class="flex flex-col items-center space-y-1">
                <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-user text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-sm"><%= giver.full_name %></span>
                </div>
            </th>
            <% end %>
            <th class="px-4 py-4 text-center border-l border-slate-200 bg-gradient-to-r from-blue-50 to-indigo-50">
                <div class="flex flex-col items-center space-y-1">
                <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-calculator text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-sm">Row_Sum</span>
                </div>
            </th>
            <th class="px-4 py-4 text-center border-l border-slate-200 bg-gradient-to-r from-purple-50 to-pink-50">
                <div class="flex flex-col items-center space-y-1">
                <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-divide text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-sm">DivideMax</span>
                </div>
            </th>
            <th class="px-4 py-4 text-center border-l border-slate-200 bg-gradient-to-r from-orange-50 to-red-50">
                <div class="flex flex-col items-center space-y-1">
                <div class="w-8 h-8 bg-gradient-to-r from-orange-500 to-red-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-star text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-sm">Grade</span>
                </div>
            </th>
            <th class="px-4 py-4 text-center border-l border-slate-200 bg-gradient-to-r from-green-50 to-emerald-50">
                <div class="flex flex-col items-center space-y-1">
                <div class="w-8 h-8 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-check-circle text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-sm">Final Marks (Out of 20)</span>
                </div>
            </th>
            <th class="px-4 py-4 text-center border-l border-slate-200 bg-gradient-to-r from-cyan-50 to-blue-50">
                <div class="flex flex-col items-center space-y-1">
                <div class="w-8 h-8 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-percentage text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700 text-sm">% Marks</span>
                </div>
            </th>
        </tr>
        </thead>
        <tbody>
        <% @students.each_with_index do |receiver, index| %>
            <tr class="<%= index.even? ? 'bg-slate-50/50' : 'bg-white' %> hover:bg-emerald-50/30 transition-colors duration-200">
            <td class="px-6 py-4 border-r border-slate-200">
                <div class="flex items-center space-x-3">
                <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center">
                    <i class="fas fa-user text-white text-xs"></i>
                </div>
                <span class="font-medium text-slate-700"><%= receiver.full_name %></span>
                </div>
            </td>
            <% @students.each do |giver| %>
                <% weighted_mark = weighted_marks[[giver.id, receiver.id]] %>
                <td class="px-4 py-4 text-center border-l border-slate-200">
                <% if weighted_mark.present? %>
                    <%= render "assignments/mark_badge",
                      value: weighted_mark[:score],
                      variant: :score,
                      precision: 2,
                      html: { data: { mark_id: weighted_mark[:mark_id], student_id: receiver.id } } %>
                <% else %>
                    <%= render "assignments/mark_badge", variant: :missing %>
                <% end %>
                </td>
            <% end %>

            <%# Row_Sum column %>
            <% calc = student_calculations[receiver.id] %>
            <td class="px-2 sm:px-4 py-3 text-center border-l border-slate-200 bg-gradient-to-r from-blue-50 to-indigo-50 align-middle">
                <%= render "assignments/mark_badge", value: calc[:row_sum], variant: :score, theme: :blue, precision: 2 %>
            </td>

            <%# DivideMax column %>
            <td class="px-2 sm:px-4 py-3 text-center border-l border-slate-200 bg-gradient-to-r from-purple-50 to-pink-50 align-middle">
                <%= render "assignments/mark_badge", value: calc[:divide_max], variant: :score, theme: :purple, precision: 2 %>
            </td>

            <%# Grade column %>
            <td class="px-2 sm:px-4 py-3 text-center border-l border-slate-200 bg-gradient-to-r from-orange-50 to-red-50 align-middle">
                <%= render "assignments/mark_badge",
                  value: calc[:grade],
                  variant: :score,
                  theme: :orange,
                  precision: 2,
                  class: "grade-value",
                  html: { data: { student_id: receiver.id, divide_max: calc[:divide_max] } } %>
            </td>

            <%# Final Grade column %>
            <td class="px-2 sm:px-4 py-3 text-center border-l border-slate-200 bg-gradient-to-r from-green-50 to-emerald-50 align-middle">
                <%= render "assignments/mark_badge",
                  value: calc[:final_grade],
                  variant: :score,
                  theme: :green,
                  class: "final-grade-value",
                  html: { data: { student_id: receiver.id, divide_max: calc[:divide_max] } } %>
            </td>

            <%# % Marks column %>
            <% percentage_mark = (calc[:final_grade].to_f / 20.0) * 100.0 %>
            <td class="px-2 sm:px-4 py-3 text-center border-l border-slate-200 bg-gradient-to-r from-cyan-50 to-blue-50 align-middle">
                <%= render "assignments/mark_badge",
                  value: percentage_mark,
                  variant: :score,
                  theme: :cyan,
                  precision: 0,
                  class: "percentage-value",
                  html: { data: { student_id: receiver.id, divide_max: calc[:divide_max] } } %>
            </td>
            </tr>
        <% end %>
        </tbody>
    </table>
    </div>
</div>

<% unless params['conversion'] == 'qass-to-webavalia' %>
    <div class="mt-6 flex justify-center">
        <%= form_with url: save_final_marks_path(@assignment, @group), method: :post, local: true, id: "final_marks_form" do |f| %>
            <%= hidden_field_tag :course_id, @course.id %>
            <%= f.hidden_field :group_score, id: "final_marks_group_score", value: @current_group_score || 18 %>
            <%= f.submit "Save Final Marks", class: "px-8 py-3 bg-gradient-to-r from-blue-500 to-indigo-500 text-white font-semibold rounded-lg hover:from-blue-600 hover:to-indigo-600 transition-all duration-200 shadow-md hover:shadow-lg text-lg" %>
        <% end %>
    </div>
<% end %>
<script>
function updateGrades() {
    const groupScore = parseFloat(document.getElementById('group_score').value) || 0;
    const gradeElements = document.querySelectorAll('.grade-value');
    const finalGradeElements = document.querySelectorAll('.final-grade-value');
    const finalMarksGroupScore = document.getElementById('final_marks_group_score');

    // Update hidden field for final marks form
    if (finalMarksGroupScore) finalMarksGroupScore.value = groupScore;

    gradeElements.forEach(element => {
        const divideMax = parseFloat(element.getAttribute('data-divide-max'));
        const newGrade = divideMax * groupScore;
        element.textContent = newGrade.toFixed(2);
    });

    finalGradeElements.forEach(element => {
        const divideMax = parseFloat(element.getAttribute('data-divide-max'));
        const newFinalGrade = Math.round(divideMax * groupScore);
        element.textContent = newFinalGrade;
    });

    const percentageElements = document.querySelectorAll('.percentage-value');
    percentageElements.forEach(element => {
        const divideMax = parseFloat(element.getAttribute('data-divide-max'));
        const newFinalGrade = Math.round(divideMax * groupScore);
        const newPercentage = (newFinalGrade / 20.0) * 100.0;
        element.textContent = newPercentage.toFixed(1);
    });
}
</script>
