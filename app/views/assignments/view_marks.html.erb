<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 p-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <%= link_to assignments_path, class: "inline-flex items-center text-slate-600 hover:text-emerald-600 transition-colors duration-200" do %>
          <i class="fas fa-arrow-left mr-2"></i>
          <span>Back to Assignments</span>
        <% end %>
      </div>
      <div class="flex items-center space-x-3 mb-2">
        <div class="w-10 h-10 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center">
          <i class="fas fa-clipboard-list text-white text-lg"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-800"><%= @assignment.title %></h1>

      </div>
      <p class="text-lg font-semibold text-emerald-700"><%= @assignment.assignment_type.titleize %></p>

      <p class="text-slate-600">Peer evaluation matrix showing scores between students</p>
    </div>


    <!-- Table Section -->
    <%= render 'table' %>

    <!-- Legend Section -->
    <div class="mt-0 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-sm text-slate-600">
        <div class="flex items-center gap-2">
          <%= render "assignments/mark_badge", value: (@assignment.qass? ? @assignment.upper_bound : 5), variant: :score %>
          <span>Score Given</span>
        </div>
        <div class="flex items-center gap-2">
          <%= render "assignments/mark_badge", variant: :missing %>
          <span>No Score</span>
        </div>
        <div class="flex items-center gap-2">
          <%= render "assignments/mark_badge", variant: :self_eval %>
          <span>Self Evaluation</span>
        </div>
      </div>
    </div>


    <!-- Legend Section -->

    <% if (@assignment.qass? || params['conversion'] == 'webavalia-to-qass') && params['conversion'] != 'qass-to-webavalia' %>
      <% qass_service = QassStandardizationService.new(@assignment.id, @group.id, conversion_params(params['conversion'])) %>
      <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'top_info' } %>
      <% if params['conversion'] == 'webavalia-to-qass' %>
        <% converted_matrix =  qass_service.converted_evalutation_matrix %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Webavalia to qass converted values</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: converted_matrix } %>
      <% end %>
      <% standardized_ratings = qass_service.qass_standardization %>
      <% if standardized_ratings.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Standardized Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'standardized_peer_rating' } %>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: standardized_ratings } %>
      <% end %>
      <% bordered_peer_ratings = qass_service.bordered_peer_ratings %>
      <% if bordered_peer_ratings.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Bordered Peer Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'bordered_peer_rating' } %>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: bordered_peer_ratings } %>
      <% end %>

      <% rescaled_peer_ratings = qass_service.rescaled_peer_ratings %>
      <% if rescaled_peer_ratings.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Rescaled Peer Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'rescaled_peer_rating' } %>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: rescaled_peer_ratings } %>
      <% end %>

      <% calibrated_peer_ratings = qass_service.calibrated_peer_ratings %>
      <% if calibrated_peer_ratings.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Calibrated Peer Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'calibrated_peer_rating' } %>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: calibrated_peer_ratings } %>
      <% end %>

      <% weighted_peer_ratings = qass_service.weighted_peer_ratings %>
      <% if weighted_peer_ratings.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Weighted Peer Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'weighted_peer_rating' } %>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: weighted_peer_ratings } %>
      <% end %>

      <% student_ratings = qass_service.student_ratings %>
      <% if student_ratings.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Student Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'student_rating_aggregation' } %>
        </div>
        <%= render partial: 'two_column_table', locals: { marks_by_students: student_ratings, formula: 'Student Ratings' } %>
      <% end %>

      <% mean_student_rating = qass_service.mean_student_rating %>
      <% if mean_student_rating.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Mean Student Ratings</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'mean_student_rating' } %>
        </div>
        <%= render partial: 'one_row_table', locals: { value: mean_student_rating, formula: 'Mean Student Rating' } %>
      <% end %>

      <% student_contributions = qass_service.student_contributions %>
      <% if student_contributions.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Student Contributions</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'student_contributions' } %>
        </div>
        <%= render partial: 'two_column_table', locals: { marks_by_students: student_contributions, formula: 'Student Contributions' } %>
      <% end %>

      <% mean_student_contribution = qass_service.mean_student_contribution %>
      <% if mean_student_contribution.present? %>
        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Mean Student Contribution</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'mean_student_contribution' } %>
        </div>
        <%= render partial: 'one_row_table', locals: { value: mean_student_contribution, formula: 'Mean Student Contribution' } %>
      <% end %>

      <% qass_group_score = @assignment_group_score&.group_score || @assignment.group_score || 0.8 %>
      <% student_contributions_ci = qass_service.student_contributions_ci %>
      <% if student_contributions_ci.present? %>
          <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <%= form_with url: save_group_marks_path(@assignment, @group), method: :post, local: true, id: "qass_group_marks_form" do |f| %>
              <%= hidden_field_tag :course_id, @course.id %>
              <div class="flex items-center space-x-4 flex-wrap gap-4">
                <div class="flex items-center space-x-2">
                  <label for="qass_group_score" class="text-lg font-semibold text-slate-700">Group Score (t):</label>
                  <%= f.number_field :group_score, id: "qass_group_score", value: qass_group_score, min: 0.00, max: 1.00, step: 0.01, class: "px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-medium", onchange: "updateQassScores()" %>
                </div>
                <% if params['conversion'] != 'webavalia-to-qass' %>
                <%= f.submit "Save Group Score", class: "px-6 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-semibold rounded-lg hover:from-emerald-600 hover:to-teal-600 transition-all duration-200 shadow-md hover:shadow-lg"%>
                <% end %>
                <span class="text-sm text-slate-500">(Enter value between 0.00 and 1.00)</span>
              </div>
            <% end %>
          </div>

        <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Mean Student Score</h3>
          <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'mean_student_score' } %>
          <div class="mt-2 text-center">
            <span class="text-muted">Lower score bound: <span id="lower_score_bound" class="font-semibold">-</span>, Upper score bound: <span id="upper_score_bound" class="font-semibold">-</span></span>
          </div>
        </div>
        <div id="mean_student_score_container" style="display: none;"></div>

        <% student_scores = qass_service.student_scores(qass_group_score) %>
        <% if student_scores.present? %>
          <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
            <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Student Marks</h3>
            <%= render partial: 'qass_formulas', locals: { rating_model: @assignment.rating_model, formula_type: 'final_score_rule' } %>
          </div>
          <div id="student_scores_table">
            <%= render partial: 'two_column_table', locals: { marks_by_students: student_scores, formula: 'Student Marks', student_contributions_ci: student_contributions_ci } %>
          </div>

          <div class="mt-6 mb-2 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
            <h3 class="mx-4 text-center text-emerald-700 text-xl font-bold">Final Student Marks</h3>
          </div>
          <div id="student_scores_normalized_table">
            <%= render partial: 'two_column_table', locals: { marks_by_students: normalized_student_scores(student_scores), formula: 'Student Marks (x 100)', student_contributions_ci: student_contributions_ci } %>
          </div>
        <% end %>

        <div class="mt-6 flex justify-center">
          <% unless params['conversion'].present? && params['conversion'] == 'webavalia-to-qass' %>
            <%= form_with url: save_final_marks_path(@assignment, @group), method: :post, local: true, id: "qass_final_marks_form" do |f| %>
              <%= hidden_field_tag :course_id, @course.id %>
              <%= f.hidden_field :group_score, id: "qass_final_marks_group_score", value: qass_group_score %>
              <%= f.submit "Save Final Marks", class: "px-8 py-3 bg-gradient-to-r from-blue-500 to-indigo-500 text-white font-semibold rounded-lg hover:from-blue-600 hover:to-indigo-600 transition-all duration-200 shadow-md hover:shadow-lg text-lg" %>
            <% end %>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <%= render 'webavalia_step1_table' %>
    <% end %>
  </div>
</div>

<% if @assignment.qass? || params['conversion'] == 'webavalia-to-qass' %>
<script>
function updateQassScores() {
  const groupScore = parseFloat(document.getElementById('qass_group_score').value) || 0;
  const groupSpread = <%= @assignment.group_spread %>;
  const finalMarksGroupScore = document.getElementById('qass_final_marks_group_score');

  // Update hidden field for final marks form
  if (finalMarksGroupScore) finalMarksGroupScore.value = groupScore;
  console.log(groupScore);
  console.log(groupSpread);
  
  // Update mean student score bounds
  const meanStudentScoreContainer = document.getElementById('mean_student_score_container');
  const lowerBoundElement = document.getElementById('lower_score_bound');
  const upperBoundElement = document.getElementById('upper_score_bound');
  
  if (meanStudentScoreContainer && lowerBoundElement && upperBoundElement) {
    // Calculate lower bound using c_bar = -1
    const lowerBound = Math.pow(groupScore, Math.pow(groupSpread, -1));
    lowerBoundElement.textContent = lowerBound.toFixed(6);
    
    // Calculate upper bound using c_bar = 1
    const upperBound = Math.pow(groupScore, Math.pow(groupSpread, 1));
    upperBoundElement.textContent = upperBound.toFixed(6);
  }

  // Update student scores
  const studentScoreElements = document.querySelectorAll('[data-student-id][data-ci-value]');
  studentScoreElements.forEach(element => {
    const ci = parseFloat(element.getAttribute('data-ci-value'));
    const newScore = Math.pow(groupScore, Math.pow(groupSpread, ci));
    element.textContent = newScore.toFixed(6);
  });

  // Update normalized student scores (multiply by 100 and round to 1 decimal)
  const normalizedTable = document.getElementById('student_scores_normalized_table');
  if (normalizedTable) {
    const normalizedScoreElements = normalizedTable.querySelectorAll('[data-student-id][data-ci-value]');
    normalizedScoreElements.forEach(element => {
      const studentId = element.getAttribute('data-student-id');
      const ci = parseFloat(element.getAttribute('data-ci-value'));
      const newScore = Math.pow(groupScore, Math.pow(groupSpread, ci));
      const normalizedScore = (newScore * 100).toFixed(1);
      element.textContent = normalizedScore;
    });
  }
}

// Initialize bounds on page load
document.addEventListener('DOMContentLoaded', function() {
  updateQassScores();
});
</script>
<% end %>
