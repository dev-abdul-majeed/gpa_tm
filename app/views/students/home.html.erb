<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
  <div class="container mx-auto px-4 py-8">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-slate-800 mb-2">
              Welcome back, <%= @student.first_name %>!
            </h1>
            <p class="text-slate-600">Ready to continue your learning journey?</p>
          </div>
          <div class="bg-gradient-to-r from-orange-500 to-amber-500 text-white p-4 rounded-lg">
            <div class="text-center">
              <div class="text-2xl font-bold"><%= @total_courses %></div>
              <div class="text-sm opacity-90">Active Courses</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <div class="flex items-center">
          <div class="bg-gradient-to-r from-orange-500 to-amber-500 p-3 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-slate-600">Total Courses</p>
            <p class="text-2xl font-semibold text-slate-800"><%= @total_courses %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <div class="flex items-center">
          <div class="bg-gradient-to-r from-orange-500 to-amber-500 p-3 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-slate-600">Groups Joined</p>
            <p class="text-2xl font-semibold text-slate-800"><%= @student.group_memberships.count %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <div class="flex items-center">
          <div class="bg-gradient-to-r from-orange-500 to-amber-500 p-3 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-slate-600">Assignments</p>
            <p class="text-2xl font-semibold text-slate-800"><%= @assignments_count %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Courses -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-slate-800">Recent Courses</h2>
        <div class="space-x-4">
          <%= link_to "My Courses", students_courses_path, class: "text-orange-500 hover:text-orange-600 font-medium" %>
          <%= link_to "My Assignments", students_assignments_path, class: "text-orange-500 hover:text-orange-600 font-medium" %>
        </div>
      </div>

      <% if @recent_courses.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @recent_courses.each do |course| %>
            <div class="border border-slate-200 rounded-lg p-4 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-slate-800 text-lg"><%= course.name %></h3>
                <span class="bg-gradient-to-r from-orange-500 to-amber-500 text-white text-xs px-2 py-1 rounded-full">
                  Active
                </span>
              </div>
              <p class="text-slate-600 text-sm mb-3 line-clamp-2"><%= course.description %></p>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span>Teacher: <%= course.teacher.full_name %></span>
                <span><%= course.students.count %> students</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-slate-800">No courses yet</h3>
          <p class="mt-1 text-sm text-slate-500">You haven't been enrolled in any courses yet.</p>
        </div>
      <% end %>
    </div>

    <!-- My Assignments -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mt-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-slate-800">My Assignments</h2>
        <%= link_to "View All", students_assignments_path, class: "text-orange-500 hover:text-orange-600 font-medium" %>
      </div>
      <% if @student_assignments.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @student_assignments.each do |assignment| %>
            <div class="border border-slate-200 rounded-lg p-4 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-slate-800 text-lg"><%= assignment.title %></h3>
                <span class="bg-gradient-to-r from-orange-500 to-amber-500 text-white text-xs px-2 py-1 rounded-full">
                  <%= assignment.assignment_type.upcase %>
                </span>
              </div>
              <p class="text-slate-600 text-sm mb-3">Course: <span class="font-medium"><%= assignment.course.name %></span></p>
              <p class="text-slate-600 text-sm mb-3">Due: <%= assignment.end_date_time&.strftime('%b %d, %Y %H:%M') || '—' %></p>
              <div class="flex items-center justify-between gap-2">
                <% submission = PeerMarkSubmission.find_by(assignment: assignment, giver: current_user) %>
                <% final_mark = @final_marks_by_assignment[assignment.id] %>
                
                <% if final_mark %>
                  <%= link_to student_view_my_marks_path(assignment), 
                      data: { turbo_frame: "modal" },
                      class: "inline-flex items-center px-3 py-2 bg-gradient-to-r from-blue-500 to-indigo-500 text-white rounded hover:from-blue-600 hover:to-indigo-600 text-sm" do %>
                    <i class="fa-solid fa-star mr-2"></i> View My Marks
                  <% end %>
                <% end %>
                
                <% if submission&.submitted? %>
                  <%= link_to student_peer_mark_summary_path(assignment.course, assignment), class: "inline-flex items-center px-3 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded hover:from-orange-600 hover:to-amber-600 text-sm" do %>
                    <i class="fa-solid fa-check mr-2"></i> View Marks
                  <% end %>
                <% else %>
                  <%= link_to student_peer_marking_path(assignment.course, assignment), class: "inline-flex items-center px-3 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded hover:from-orange-600 hover:to-amber-600 text-sm" do %>
                    <i class="fa-solid fa-pen mr-2"></i> Start Marking
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-slate-800">No assignments yet</h3>
          <p class="mt-1 text-sm text-slate-500">Assignments will appear here once your teacher adds them.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
