<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
  <%= form_with model: [@course, @assignment], local: true, class: "space-y-6" do |form| %>
    <% if @assignment.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <i class="fas fa-exclamation-triangle text-red-400"></i>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              <%= pluralize(@assignment.errors.count, "error") %> prohibited this assignment from being saved:
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @assignment.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Basic Information -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold text-slate-800 border-b border-slate-200 pb-2">Basic Information</h3>

      <div>
        <%= form.label :title, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.text_field :title, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500", placeholder: "Enter assignment title" %>
      </div>

      <div>
        <%= form.label :assignment_type, "Assignment Type", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.select :assignment_type, options_for_select([['Qass', 'qass'], ['Webavalia', 'webavalia']], @assignment.assignment_type), {}, { disabled: true, class: "w-full px-3 py-2 border border-slate-300 rounded-lg bg-slate-100 text-slate-600" } %>
        <%= form.hidden_field :assignment_type, value: @assignment.assignment_type %>
      </div>
    </div>

    <!-- Rating Configuration -->

    <div class="space-y-4">
      <h3 class="text-lg font-semibold text-slate-800 border-b border-slate-200 pb-2">Rating Configuration</h3>

      <div>
        <%= form.label :rating_scale, "Rating Scale (0-100)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :rating_scale, min: 0, max: 100, step: @step, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500", placeholder: "Enter rating scale (0-100)" %>
        <p class="text-xs text-slate-500 mt-1">Scale from 0 to 100, incrementing by <%= @step %></p>
      </div>

      <div>
        <%= form.label :rating_model, "Rating Model", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <% default_rating_model = @assignment.assignment_type == 'webavalia' ? 'C' : (@assignment.rating_model || 'B') %>
        <% is_disabled = @assignment.assignment_type == 'webavalia' %>
        <%= form.select :rating_model, options_for_select([['B (50 points)', 'B'], ['C (100 points)', 'C'], ['D (0 points)', 'D']], default_rating_model), {}, { disabled: is_disabled, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 #{is_disabled ? 'bg-slate-100 text-slate-600' : ''}" } %>
      </div>

      <div>
        <%= form.label :lower_bound, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :lower_bound, min: 1, max: 7, step: 1, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= form.label :upper_bound, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :upper_bound, min: 1, max: 7, step: 1, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= form.label :border_size, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :border_size, min: 0.001, max: 0.1, step: 0.001, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= form.label :polarity_factor, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :polarity_factor, min: 0.001, max: 1.0, step: 0.001, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= form.label :group_spread, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :group_spread, min: 0.001, max: 0.9, step: 0.001, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>


      <div id="self-rating-section" class="<%= @assignment.assignment_type == 'webavalia' ? '' : 'hidden' %>">
        <%= form.label :self_rating_weight, "Self-Rating Weight (%)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= form.number_field :self_rating_weight, min: 0.0, max: 100.0, step: 1, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500", placeholder: "Enter self-rating weight (0.00-100.00)" %>
        <p class="text-xs text-slate-500 mt-1">Weight percentage for self-assessment (0.00 to 100.00)</p>
      </div>

      <div id="calibration-section" class="<%= @assignment.assignment_type == 'qass' ? '' : 'hidden' %>">
        <div class="flex items-center space-x-3">
          <%= form.check_box :calibration, class: "w-4 h-4 text-emerald-600 bg-slate-100 border-slate-300 rounded focus:ring-emerald-500 focus:ring-2" %>
          <%= form.label :calibration, "Enable Calibration", class: "text-sm font-medium text-slate-700" %>
        </div>
        <p class="text-xs text-slate-500 mt-1">Enable calibration for Qass assignments</p>
      </div>
    </div>

    <!-- Schedule -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold text-slate-800 border-b border-slate-200 pb-2">Schedule</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :start_date_time, "Start Date & Time", class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= form.datetime_local_field :start_date_time, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
        </div>

        <div>
          <%= form.label :end_date_time, "End Date & Time", class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= form.datetime_local_field :end_date_time, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex justify-between items-center pt-6 border-t border-slate-200">
      <% if @assignment.persisted? %>
        <%= link_to "← Back to Assignments", assignments_path, class: "text-slate-600 hover:text-slate-800 transition-colors" %>
      <% else %>
        <%= link_to "← Back to Type Selection", select_assignment_type_path(course_id: @course.id), class: "text-slate-600 hover:text-slate-800 transition-colors" %>
      <% end %>

      <div class="space-x-3">
        <%= link_to "Cancel", assignments_path, class: "px-4 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors" %>
        <%= form.submit (@assignment.persisted? ? "Update Assignment" : "Create Assignment"), class: "px-6 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-lg hover:from-emerald-600 hover:to-teal-600 transition-colors" %>
      </div>
    </div>
  <% end %>
</div>

<script>
(function() {
  const assignmentType = '<%= @assignment.assignment_type %>';
  const selfRatingSection = document.getElementById('self-rating-section');
  const calibrationSection = document.getElementById('calibration-section');
  const ratingModel = document.getElementById('assignment_rating_model');

  if (assignmentType === 'webavalia') {
    console.log('webavalia');
    selfRatingSection.classList.remove('hidden');
    calibrationSection.classList.add('hidden');
    // Ensure option C is selected for webavalia assignments
    if (ratingModel) {
      ratingModel.value = "C";
      // Trigger change event to ensure any listeners are notified
      ratingModel.dispatchEvent(new Event('change'));
    }
  } else {
    selfRatingSection.classList.add('hidden');
    calibrationSection.classList.remove('hidden');
  }
})();
</script>
