<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 p-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6">
      <div class="flex items-center space-x-3 mb-2">
        <div class="w-10 h-10 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center">
          <i class="fas fa-clipboard-list text-white text-lg"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-800"><%= @assignment.title %></h1>

      </div>
      <h4 class="text-xl font-bold text-slate-800"><%= @assignment.assignment_type.titleize %></h1>

      <p class="text-slate-600">Peer evaluation matrix showing scores between students</p>
    </div>


    <!-- Table Section -->
    <%= render 'table' %>

    <!-- Legend Section -->
    <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
      <div class="flex items-center justify-center space-x-8 text-sm text-slate-600">
        <div class="flex items-center space-x-2">
          <div class="w-6 h-6 rounded-full bg-gradient-to-r from-emerald-100 to-teal-100 border-2 border-emerald-200 flex items-center justify-center">
            <span class="text-emerald-700 font-bold text-xs">5</span>
          </div>
          <span>Score Given</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-6 h-6 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center">
            <span class="text-slate-400 text-xs">N/A</span>
          </div>
          <span>No Score</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center">
            <span class="text-slate-400 font-medium text-xs">–</span>
          </div>
          <span>Self Evaluation</span>
        </div>
      </div>
    </div>


    <!-- Legend Section -->

    <% if @assignment.qass? || params['conversion'] == 'webavalia-to-qass' %>
      <% qass_service = QassStandardizationService.new(@assignment.id, @group.id, conversion_params(params['conversion'])) %>

      <% if params['conversion'] == 'webavalia-to-qass' %>
        <% converted_matrix =  qass_service.converted_evalutation_matrix %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Webavalia to qass converted values</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: converted_matrix } %>
      <% end %>
      <% standardized_ratings = qass_service.qass_standardization %>
      <% if standardized_ratings.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Standardized Ratings</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: standardized_ratings } %>
      <% end %>
      <% bordered_peer_ratings = qass_service.bordered_peer_ratings %>
      <% if bordered_peer_ratings.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Bordered Peer Ratings</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: bordered_peer_ratings } %>
      <% end %>

      <% rescaled_peer_ratings = qass_service.rescaled_peer_ratings %>
      <% if rescaled_peer_ratings.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Rescaled Peer Ratings</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: rescaled_peer_ratings } %>
      <% end %>

      <% calibrated_peer_ratings = qass_service.calibrated_peer_ratings %>
      <% if calibrated_peer_ratings.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Calibrated Peer Ratings</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: calibrated_peer_ratings } %>
      <% end %>

      <% weighted_peer_ratings = qass_service.weighted_peer_ratings %>
      <% if weighted_peer_ratings.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Weighted Peer Ratings</h3>
        </div>
        <%= render partial: 'qass_rating_table', locals: { marks_by_pair: weighted_peer_ratings } %>
      <% end %>

      <% student_ratings = qass_service.student_ratings %>
      <% if student_ratings.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Student Ratings</h3>
        </div>
        <%= render partial: 'two_column_table', locals: { marks_by_students: student_ratings, formula: 'ri/(1-r1)' } %>
      <% end %>

      <% mean_student_rating = qass_service.mean_student_rating %>
      <% if mean_student_rating.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Mean Student Ratings</h3>
        </div>
        <%= render partial: 'one_row_table', locals: { value: mean_student_rating, formula: 'ri_bar/(1-r1_bar)' } %>
      <% end %>

      <% student_contributions = qass_service.student_contributions %>
      <% if student_contributions.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Student Contributions</h3>
        </div>
        <%= render partial: 'two_column_table', locals: { marks_by_students: student_contributions, formula: '(1 + c1 )/(1 - r1)' } %>
      <% end %>

      <% mean_student_contribution = qass_service.mean_student_contribution %>
      <% if mean_student_contribution.present? %>
        <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <h3 class="mx-4 text-center text-emerald-700">Mean Student Ratings</h3>
        </div>
        <%= render partial: 'one_row_table', locals: { value: mean_student_contribution, formula: 'Multiplied Result' } %>
      <% end %>

      <% qass_group_score = @assignment_group_score&.group_score || @assignment.group_score || 0.8 %>
      <% student_contributions_ci = qass_service.student_contributions_ci %>
      <% if student_contributions_ci.present? %>
        <% unless params['conversion'].present? && params['conversion'] == 'webavalia-to-qass' %>
          <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <%= form_with url: save_group_marks_path(@assignment, @group), method: :post, local: true, id: "qass_group_marks_form" do |f| %>
              <%= hidden_field_tag :course_id, @course.id %>
              <div class="flex items-center space-x-4 flex-wrap gap-4">
                <div class="flex items-center space-x-2">
                  <label for="qass_group_score" class="text-lg font-semibold text-slate-700">Group Score (t):</label>
                  <%= f.number_field :group_score, id: "qass_group_score", value: qass_group_score, min: 0.00, max: 1.00, step: 0.01, class: "px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-medium", onchange: "updateQassScores()" %>
                </div>
                <%= f.submit "Save Group Score", class: "px-6 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-semibold rounded-lg hover:from-emerald-600 hover:to-teal-600 transition-all duration-200 shadow-md hover:shadow-lg" %>
                <span class="text-sm text-slate-500">(Enter value between 0.00 and 1.00)</span>
              </div>
            <% end %>
          </div>
        <% end %>

        <% mean_student_score = qass_service.mean_student_score(qass_group_score) %>
        <% c_bar = qass_service.c_bar %>
        <% if mean_student_score.present? %>
          <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
            <h3 class="mx-4 text-center text-emerald-700">Mean Student Score</h3>
          </div>
          <div id="mean_student_score_container" data-c-bar="<%= c_bar %>">
            <%= render partial: 'one_row_table', locals: { value: mean_student_score, formula: 'ś = t ^ (z ^ ć)', id: 'mean_student_score' } %>
          </div>
        <% end %>

        <% student_scores = qass_service.student_scores(qass_group_score) %>
        <% if student_scores.present? %>
          <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
            <h3 class="mx-4 text-center text-emerald-700">Student Scores</h3>
          </div>
          <div id="student_scores_table">
            <%= render partial: 'two_column_table', locals: { marks_by_students: student_scores, formula: 'Student Scores', student_contributions_ci: student_contributions_ci } %>
          </div>

          <div class="mt-6 mb-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
            <h3 class="mx-4 text-center text-emerald-700">Student Scores Normalized</h3>
          </div>
          <div id="student_scores_table">
            <%= render partial: 'two_column_table', locals: { marks_by_students: normalized_student_scores(student_scores), formula: 'Student Scores', student_contributions_ci: student_contributions_ci } %>
          </div>
        <% end %>

        <div class="mt-6 flex justify-center">
          <% unless params['conversion'].present? && params['conversion'] == 'webavalia-to-qass' %>
            <%= form_with url: save_final_marks_path(@assignment, @group), method: :post, local: true, id: "qass_final_marks_form" do |f| %>
              <%= hidden_field_tag :course_id, @course.id %>
              <%= f.hidden_field :group_score, id: "qass_final_marks_group_score", value: qass_group_score %>
              <%= f.submit "Save Final Marks", class: "px-8 py-3 bg-gradient-to-r from-blue-500 to-indigo-500 text-white font-semibold rounded-lg hover:from-blue-600 hover:to-indigo-600 transition-all duration-200 shadow-md hover:shadow-lg text-lg" %>
            <% end %>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <%= render 'webavalia_step1_table' %>
    <% end %>
  </div>
</div>

<% if @assignment.qass? %>
<script>
function updateQassScores() {
  const groupScore = parseFloat(document.getElementById('qass_group_score').value) || 0;
  const groupSpread = <%= @assignment.group_spread %>;
  const finalMarksGroupScore = document.getElementById('qass_final_marks_group_score');

  // Update hidden field for final marks form
  if (finalMarksGroupScore) finalMarksGroupScore.value = groupScore;
  console.log(groupScore);
  console.log(groupSpread);
  // Update mean student score
  const meanStudentScoreContainer = document.getElementById('mean_student_score_container');
  const meanStudentScoreElement = document.getElementById('mean_student_score');
  if (meanStudentScoreContainer && meanStudentScoreElement) {
    const cBar = parseFloat(meanStudentScoreContainer.getAttribute('data-c-bar')) || 0;
    const newMeanScore = Math.pow(groupScore, Math.pow(groupSpread, cBar));
    meanStudentScoreElement.textContent = newMeanScore.toFixed(6);
    console.log(newMeanScore);
  }

  // Update student scores
  const studentScoreElements = document.querySelectorAll('[data-student-id][data-ci-value]');
  studentScoreElements.forEach(element => {
    const ci = parseFloat(element.getAttribute('data-ci-value'));
    const newScore = Math.pow(groupScore, Math.pow(groupSpread, ci));
    element.textContent = newScore.toFixed(6);
  });
}
</script>
<% end %>
