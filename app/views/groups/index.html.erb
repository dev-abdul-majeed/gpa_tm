<div class="min-h-screen bg-gradient-to-br from-slate-50 to-emerald-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Course Header -->
    <div class="mb-8">
      <div class="flex items-center mb-2">
        <%= link_to courses_path, class: "text-slate-500 hover:text-emerald-600 transition-colors duration-200 mr-2" do %>
          <i class="fas fa-arrow-left"></i>
        <% end %>
        <h1 class="text-3xl font-bold text-slate-800"><%= @course.name %></h1>
      </div>
      <p class="text-slate-600"><%= @course.description %></p>
    </div>

    <!-- Groups Section -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold text-slate-800 flex items-center">
          <i class="fas fa-layer-group mr-3 text-emerald-500"></i>
          Groups
        </h2>
        <%= link_to new_group_path(@course), 
          class: "inline-flex items-center px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white font-medium rounded-lg transition-all duration-200 shadow-sm hover:shadow-md" do %>
          <i class="fas fa-plus mr-2"></i>
          Create New Group
        <% end %>
      </div>

      <!-- Groups Grid -->
      <% if @groups.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @groups.each do |group| %>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 hover:shadow-md transition-all duration-200 p-6">
              <!-- Group Header -->
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-lg font-semibold text-slate-800 flex items-center">
                  <i class="fas fa-users mr-2 text-emerald-500"></i>
                  <%= group.group_name %>
                </h3>
                <div class="flex space-x-2">
                  <%= link_to edit_course_group_path(@course, group), 
                    class: "inline-flex items-center justify-center w-8 h-8 bg-slate-100 hover:bg-emerald-100 text-slate-600 hover:text-emerald-600 rounded-lg transition-all duration-200",
                    title: "Edit Group" do %>
                    <i class="fas fa-edit text-sm"></i>
                  <% end %>
                  <%= link_to course_group_path(@course, group), 
                    method: :delete,
                    data: { 
                      confirm: "Are you sure you want to delete this group? All student assignments will be removed.",
                      turbo_method: :delete 
                    },
                    class: "inline-flex items-center justify-center w-8 h-8 bg-red-100 hover:bg-red-200 text-red-600 hover:text-red-700 rounded-lg transition-all duration-200",
                    title: "Delete Group" do %>
                    <i class="fas fa-trash text-sm"></i>
                  <% end %>
                </div>
              </div>

              <!-- Student Count -->
              <div class="flex items-center mb-3 text-sm text-slate-500">
                <i class="fas fa-user-friends mr-2 text-emerald-500"></i>
                <span><%= pluralize(group.students.count, 'student') %></span>
              </div>

              <!-- Students List -->
              <div class="space-y-2">
                <% if group.students.any? %>
                  <div class="text-sm">
                    <% group.students.each do |student| %>
                      <div class="flex items-center py-1 text-slate-600">
                        <i class="fas fa-user-circle mr-2 text-slate-400"></i>
                        <%= student.full_name %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-sm text-slate-400 italic py-2">
                    <i class="fas fa-info-circle mr-1"></i>
                    No students assigned yet
                  </div>
                <% end %>
              </div>

              <!-- Manage Students Link -->
              <div class="mt-4 pt-4 border-t border-slate-100">
                <%= link_to course_group_path(@course, group), 
                  class: "inline-flex items-center text-sm text-emerald-600 hover:text-emerald-700 font-medium transition-colors duration-200" do %>
                  <i class="fas fa-cog mr-2"></i>
                  Manage Students
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="text-center py-12">
          <div class="mx-auto w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mb-4">
            <i class="fas fa-layer-group text-3xl text-slate-400"></i>
          </div>
          <h3 class="text-lg font-medium text-slate-600 mb-2">No Groups Created Yet</h3>
          <p class="text-slate-500 mb-6">Create your first group to organize students in this course.</p>
          <%= link_to new_group_path(@course), 
            class: "inline-flex items-center px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-medium rounded-lg transition-all duration-200 shadow-sm hover:shadow-md" do %>
            <i class="fas fa-plus mr-2"></i>
            Create First Group
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Available Students Section -->
    <% if @available_students.any? %>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
          <i class="fas fa-user-plus mr-2 text-amber-500"></i>
          Students Not in Any Group (<%= @available_students.count %>)
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          <% @available_students.each do |student| %>
            <div class="flex items-center py-2 px-3 bg-amber-50 rounded-lg text-sm">
              <i class="fas fa-user-circle mr-2 text-amber-500"></i>
              <span class="text-slate-700"><%= student.full_name %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>