<div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
  <!-- Course Header -->
  <div class="p-6">
    <div class="flex items-start justify-between">
      <div class="flex-1">
        <div class="flex items-center mb-3">
          <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center mr-3 shadow-sm">
            <i class="fas fa-book-open text-white text-sm"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-800 hover:text-emerald-600 transition-colors duration-200">
            <%= link_to course.name, course_path(course), class: "hover:text-emerald-600" %>
          </h3>
        </div>
        
        <p class="text-slate-600 mb-4 leading-relaxed">
          <%= truncate(course.description, length: 50, separator: ' ') %>
          <% if course.description.length > 50 %>
            <%= link_to course_path(course), class: "text-emerald-600 hover:text-emerald-700 ml-1" do %>
              <i class="fas fa-external-link-alt text-xs"></i>
            <% end %>
          <% end %>
        </p>
        
        <!-- Course Meta Info -->
        <div class="flex items-center justify-between text-sm text-slate-500">
          <div class="flex items-center space-x-6">
            <div class="flex items-center">
              <i class="fas fa-users mr-2 text-emerald-500"></i>
              <span><%= pluralize(course.students.count, 'student') %></span>
            </div>
            <div class="flex items-center">
              <i class="fas fa-calendar-alt mr-2 text-emerald-500"></i>
              <span>Created <%= time_ago_in_words(course.created_at) %> ago</span>
            </div>
            <div class="flex items-center">
              <i class="fas fa-clock mr-2 text-emerald-500"></i>
              <span>Updated <%= time_ago_in_words(course.updated_at) %> ago</span>
            </div>
          </div>
          
          

        </div>
      </div>
      
      <!-- Action Buttons -->
      
      <div class="ml-4">
        <div class="flex items-center space-x-2">
          <%= link_to edit_course_path(course), 
              class: "inline-flex items-center justify-center w-10 h-10 bg-slate-100 hover:bg-emerald-100 text-slate-600 hover:text-emerald-600 rounded-lg transition-all duration-200",
              title: "Edit Course" do %>
            <i class="fas fa-edit"></i>
          <% end %>

          <%= link_to course_path(course), 
              class: "inline-flex items-center justify-center w-10 h-10 bg-emerald-100 hover:bg-emerald-200 text-emerald-600 hover:text-emerald-700 rounded-lg transition-all duration-200",
              title: "View Course" do %>
            <i class="fas fa-eye"></i>
          <% end %>

          <%= link_to course_path(course), 
              data: { turbo_method: :delete, turbo_confirm: 'Are you sure? This action can not be undone!' },
              class: "inline-flex items-center justify-center w-10 h-10 bg-red-100 hover:bg-red-200 text-red-600 hover:text-red-700 rounded-lg transition-all duration-200",
              title: "Delete Course" do %>
            <i class="fas fa-trash"></i>
          <% end %>
        </div>

        <!-- "Manage Groups" -->
        <% if course.students.any? %>
          <div class="mt-2">
            <%= link_to groups_path(course), 
                class: "inline-flex items-center justify-start gap-2 w-auto px-4 h-10 bg-slate-100 hover:bg-emerald-100 text-slate-600 hover:text-emerald-600 rounded-lg transition-all duration-200" do %>
              <i class="fa-solid fa-layer-group"></i>
              <span>Manage Groups</span>
            <% end %>
          </div>
        <% end %>
      </div>

    </div>
  </div>

  <!-- Students Accordion -->
  <div class="border-t border-slate-200">
    <button 
      class="w-full px-6 py-4 text-left hover:bg-slate-50 transition-colors duration-200 focus:outline-none focus:bg-slate-50"
      onclick="toggleAccordion('students-<%= course.id %>')"
      id="accordion-button-<%= course.id %>">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <i class="fas fa-users text-emerald-500 mr-3"></i>
          <span class="text-sm font-semibold text-slate-700">
            Students Enrolled (<%= course.students.count %>)
          </span>
        </div>
        <div class="flex items-center">
          <% if course.students.count > 0 %>
            <div class="flex -space-x-2 mr-3">
              <% course.students.limit(3).each do |student| %>
                <div class="w-6 h-6 bg-gradient-to-r from-orange-400 to-amber-400 rounded-full border-2 border-white flex items-center justify-center">
                  <span class="text-xs font-bold text-white"><%= student.full_name.first.upcase rescue '?' %></span>
                </div>
              <% end %>
              <% if course.students.count > 3 %>
                <div class="w-6 h-6 bg-slate-400 rounded-full border-2 border-white flex items-center justify-center">
                  <span class="text-xs font-bold text-white">+<%= course.students.count - 3 %></span>
                </div>
              <% end %>
            </div>
          <% end %>
          <i class="fas fa-chevron-down text-slate-400 transform transition-transform duration-200" id="chevron-<%= course.id %>"></i>
        </div>
      </div>
    </button>
    
    <!-- Students List (Collapsible) -->
    <div class="hidden" id="students-<%= course.id %>">
      <div class="px-6 pb-6 pt-5">
        <% if course.students.any? %>
          <div class="space-y-3">
            <% course.students.each do |student| %>
              <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-gradient-to-r from-orange-500 to-amber-500 rounded-full flex items-center justify-center mr-3 shadow-sm">
                    <span class="text-sm font-bold text-white"><%= student.full_name.first.upcase rescue '?' %></span>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-slate-800"><%= student.full_name %></p>
                    <p class="text-xs text-slate-500"><%= student.email %></p>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <div class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded-md text-xs font-medium">
                    Active
                  </div>
                  <div class="relative" data-dropdown="student-<%= student.id %>">
                    <button class="text-slate-400 hover:text-slate-600 transition-colors duration-200 p-1" 
                            title="Student Options"
                            onclick="toggleDropdown('student-<%= student.id %>')">
                      <i class="fas fa-ellipsis-v"></i>
                    </button>
                    
                    <div class="absolute right-0 top-8 w-48 bg-white rounded-lg shadow-xl border border-slate-200 z-50 hidden"
                         id="dropdown-student-<%= student.id %>">
                      <div class="py-2">
                        <%= link_to remove_student_course_path(course, student), 
                            data: {turbo_method: :delete, turbo_confirm: "Are you sure you want to remove #{student.full_name} from this course?"},
                            class: "flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors duration-200" do %>
                          <i class="fas fa-user-minus mr-3"></i>
                          Remove Student
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            <% end %>
            
            <button class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white text-sm font-medium rounded-lg transition-all duration-200"
                    onclick="window.location.href='<%= invite_students_course_path(course) %>'">
              <i class="fas fa-user-plus mr-2"></i>
              Add More Students
            </button>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3">
              <i class="fas fa-user-plus text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 mb-3">No students enrolled yet</p>
            <button class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white text-sm font-medium rounded-lg transition-all duration-200"
                    onclick="window.location.href='<%= invite_students_course_path(course) %>'">
              <i class="fas fa-user-plus mr-2"></i>
              Add Students
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>


<%= javascript_include_tag 'courses' %>
