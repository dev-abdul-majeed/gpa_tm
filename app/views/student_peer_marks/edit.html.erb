<div class="container mx-auto px-4 py-8">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Group Marking</h1>
        <p class="text-slate-600">Distribute exactly 100 points across your group members (including yourself).</p>
      </div>
      <div class="text-sm text-slate-500">
        <span class="font-semibold">Course:</span> <%= @course.name %> · 
        <span class="font-semibold">Assignment:</span> <%= @assignment.title %>
      </div>
    </div>

    <% if @submission.submitted? %>
      <div class="bg-orange-50 border border-orange-200 text-orange-700 px-4 py-3 rounded mb-6">
        <i class="fa-solid fa-lock mr-2"></i> Your submission is locked. You can view your given marks in the summary.
      </div>
    <% end %>

    <%= form_with url: update_student_peer_marking_path(@course, @assignment), method: :patch, local: true do %>
      <div class="space-y-4" id="peer-marks-list">
        <% @group_members.each do |member| %>
          <% mark = @peer_marks[member.id] %>
          <div class="flex items-center justify-between">
            <div class="text-slate-700">
              <i class="fa-solid fa-user mr-2 text-slate-400"></i>
              <%= member.first_name %> <%= member.last_name %>
              <% if member.id == current_user.id %>
                <span class="ml-2 text-xs text-slate-500">(You)</span>
              <% end %>
            </div>
            <div>
              <input type="number" name="peer_marks[<%= member.id %>][score]" value="<%= mark&.score || 0 %>" min="0" max="100" class="w-24 border border-slate-300 rounded-lg px-3 py-2 text-right" <%= 'disabled' if @submission.submitted? %>>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex items-center justify-between">
        <div class="text-slate-600 text-sm">Total: <span id="peer-marks-total" class="font-semibold">0</span> / <span class="font-semibold">100</span></div>
        <div class="space-x-3">
          <% unless @submission.submitted? %>
            <button type="submit" class="inline-flex items-center px-4 py-2 border border-orange-500 text-orange-600 rounded-lg hover:bg-orange-50"><i class="fa-solid fa-save mr-2"></i> Save Draft</button>
            <button type="submit" name="finalize" value="true" data-turbo-confirm="Submit and lock your marks? You will not be able to edit after submitting." class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600"><i class="fa-solid fa-check mr-2"></i> Submit</button>
          <% else %>
            <%= link_to 'View Summary', student_peer_mark_summary_path(@course, @assignment), class: "inline-flex items-center px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-lg hover:from-orange-600 hover:to-amber-600" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const container = document.getElementById('peer-marks-list');
    if (!container) return;
    const inputs = container.querySelectorAll('input[type="number"]');
    const totalEl = document.getElementById('peer-marks-total');

    function updateTotal() {
      let sum = 0;
      inputs.forEach((i) => {
        const val = parseInt(i.value, 10);
        if (!isNaN(val)) sum += val;
      });
      if (totalEl) totalEl.textContent = sum;
    }

    inputs.forEach((i) => {
      i.addEventListener('input', updateTotal);
      i.addEventListener('change', updateTotal);
    });

    updateTotal();
  })();
</script>

